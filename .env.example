DATABASE_URL=postgres://postgres:postgres@localhost:5434/live_chat
PORT=8080
HOST_PORT=8083
DB_HOST_PORT=5434
FRONTEND_HOST_PORT=5173
# Secret used to sign JWTs. MUST be overridden with a strong random value
# outside local development (the default is intentionally insecure).
JWT_SECRET=dev-only-insecure-secret-change-me
# Optional: cross-instance broadcasting. Set REDIS_URL (host-side port; the
# compose service below maps it to container 6379) and the API runs in
# pub/sub mode. Leave it commented/empty for single-instance in-memory
# broadcasting.
# REDIS_HOST_PORT=6381
# REDIS_URL=redis://localhost:6381
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=live_chat
# GH_TOKEN=
# GITHUB_TOKEN=
