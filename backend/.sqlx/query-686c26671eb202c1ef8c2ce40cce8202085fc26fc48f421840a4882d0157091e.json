{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.name, r.created_by, r.created_at,\n                      EXISTS (\n                          SELECT 1 FROM room_memberships m\n                          WHERE m.room_id = r.id AND m.user_id = $1\n                      ) AS \"member!\"\n               FROM rooms r\n               ORDER BY r.created_at, r.id",
