  "query": "SELECT DISTINCT ON (m.room_id)\n                      m.id, m.room_id, m.user_id, u.username, m.body, m.created_at\n               FROM messages m\n               JOIN users u ON u.id = m.user_id\n               ORDER BY m.room_id, m.created_at DESC, m.id DESC",
