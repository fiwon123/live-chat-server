{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id, m.room_id, m.user_id, u.username, m.body, m.created_at\n                       FROM messages m\n                       JOIN users u ON u.id = m.user_id\n                       WHERE m.room_id = $1\n                       ORDER BY m.created_at DESC, m.id DESC\n                       LIMIT $2",
